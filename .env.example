# =============================================================================
# MEDICARE+ CLINIC MANAGEMENT SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Flask Application Security Key (Generate a random 32+ char string for production)
SECRET_KEY=replace-with-a-random-secret-key-32-chars-long

# Enforce MySQL connection (Prevents silent SQLite fallback on cloud hosts)
REQUIRE_MYSQL=true

# -----------------------------------------------------------------------------
# OPTION 1: Aiven Managed MySQL (Recommended — Single Service URI)
# -----------------------------------------------------------------------------
# Copy the "Service URI" from your Aiven Console overview page:
# DATABASE_URL=mysql://avnadmin:your_aiven_password@mysql-project-name.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# -----------------------------------------------------------------------------
# OPTION 2: Individual Connection Parameters (Local MySQL or Aiven)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=clinic_management

# Optional SSL CA certificate:
# - DB_SSL_CA=ca.pem (path to ca.pem downloaded from Aiven console)
# - DB_SSL_CERT_CONTENT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# If neither is provided, TLS encryption is automatically enabled for Aiven.
